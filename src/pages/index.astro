---
const specimens = [
  { id: '01', name: 'Limonita', category: 'Óxidos e hidróxidos', color: 'Amarillo ocre / pardo', hardness: '1–5,5', formula: 'Mezcla de óxidos e hidróxidos hidratados de hierro', streak: 'Amarillo parduzco', luster: 'Terroso, mate o submetálico', habit: 'Masivo, terroso o botrioidal', note: 'No es una especie mineral única, sino una mezcla de hidróxidos de hierro en la que predomina la goethita. Por eso su dureza varía tanto de una muestra a otra.', lab: 'Raya sobre porcelana sin esmaltar: debe salir amarilla parda. Si sale roja, la muestra es hematita.', image: '/images/01-limonita.jpeg' },
  { id: '02', name: 'Halita', category: 'Silicatos · clínker', color: 'Incolora, grisácea o blanquecina', hardness: 'No diagnóstica', formula: 'Ca₃SiO₅', streak: 'No suele utilizarse', luster: 'Vítreo', habit: 'Granos o cristales microscópicos', note: 'Componente mayoritario del clínker de cemento Portland. No es de origen natural: se forma en el horno, por sobre los 1450 °C.', lab: 'A simple vista no se distingue. Se identifica por microscopía sobre sección pulida o por difracción de rayos X.', image: '/images/02-alita.jpeg' },
  { id: '03', name: 'Magnetita', category: 'Óxidos', color: 'Negro o gris negruzco', hardness: '5,5–6,5', formula: 'Fe₃O₄', streak: 'Negra', luster: 'Metálico o submetálico', habit: 'Octaédrico, granular o masivo', note: 'Es ferrimagnética, de modo que atrae un imán sin necesidad de imantarla. Con unos 5,2 g/cm³ se siente pesada para su tamaño.', lab: 'Acercar un imán: la atracción es inmediata. La raya, sobre porcelana, sale negra.', image: '/images/03-magnetita.jpeg' },
  { id: '04', name: 'Epidota', category: 'Silicatos · sorosilicatos', color: 'Verde pistacho / amarillento', hardness: '6–7', formula: 'Ca₂(Al,Fe³⁺)₃(SiO₄)₃(OH)', streak: 'Blanca o gris muy clara', luster: 'Vítreo', habit: 'Prismático, alargado o granular', note: 'El verde pistacho proviene del hierro férrico que sustituye al aluminio dentro de la estructura cristalina.', lab: 'Buscar cristales prismáticos con estrías paralelas al eje largo. Con dureza 6–7, raya el vidrio sin dificultad.', image: '/images/04-epidota.jpeg' },
  { id: '05', name: 'Hematita especular', category: 'Óxidos', color: 'Gris acero / plateado', hardness: '5–6,5', formula: 'Fe₂O₃', streak: 'Rojo parduzco', luster: 'Metálico, intenso y reflectante', habit: 'Laminar, escamoso o especular', note: 'Variedad laminar de la hematita. El brillo plateado despista, pero la raya sigue siendo roja parda.', lab: 'La raya la separa de la magnetita, que deja negro. Tampoco responde al imán.', image: '/images/05-hematita-especular.jpeg' },
  { id: '06', name: 'Lapislázuli', category: 'Roca · silicatos', color: 'Azul intenso / ultramarino', hardness: '5–5,5', formula: 'Roca compuesta principalmente por lazurita', streak: 'Azul pálida o blanquecina', luster: 'Vítreo o mate', habit: 'Masivo, compacto y granular', note: 'No es un mineral sino una roca: lazurita azul, calcita blanca y pirita dorada mezcladas en proporciones variables.', lab: 'Con lupa deben verse los tres componentes. Un azul parejo, sin pirita ni vetas blancas, suele indicar howlita o jaspe teñidos.', image: '/images/06-lapislazuli.jpeg' },
  { id: '07', name: 'Brochantita', category: 'Sulfatos', color: 'Verde esmeralda / intenso', hardness: '3,5–4', formula: 'Cu₄SO₄(OH)₆', streak: 'Verde pálida', luster: 'Vítreo o mate', habit: 'Costras, agregados fibrosos o aciculares', note: 'Sulfato de cobre que se origina por oxidación de sulfuros. Es frecuente en las zonas de alteración de los yacimientos cupríferos del norte de Chile.', lab: 'Con lupa se observan agregados aciculares o fibrosos. Frente a la atacamita, la diferencia está en la composición: sulfato en lugar de cloruro.', image: '/images/07-brochantita.jpeg' },
  { id: '08', name: 'Azufre', category: 'Elementos nativos', color: 'Amarillo limón / anaranjado', hardness: '1,5–2,5', formula: 'S', streak: 'Blanca o amarillenta', luster: 'Resinoso', habit: 'Bipiramidal, granular o masivo', note: 'Elemento nativo y mal conductor del calor. Sostenido en la mano, un cristal puede agrietarse solo por el calor corporal.', lab: 'Se raya con la uña. No quemar la muestra: libera dióxido de azufre, que es tóxico.', image: '/images/08-azufre.jpeg' },
  { id: '09', name: 'Pirita', category: 'Sulfuros', color: 'Amarillo latón / dorado pálido', hardness: '6–6,5', formula: 'FeS₂', streak: 'Negra verdosa', luster: 'Metálico', habit: 'Cúbico, piritoédrico o granular', note: 'Conocida como el oro de los tontos. A diferencia del oro, es frágil: bajo un golpe se quiebra en vez de deformarse.', lab: 'Buscar caras cúbicas con estrías paralelas. La raya sale negra verdosa, nunca dorada.', image: '/images/09-pirita.jpeg' },
  { id: '10', name: 'Aragonito', category: 'Carbonatos', color: 'Blanco, crema o amarillento', hardness: '3,5–4', formula: 'CaCO₃', streak: 'Blanca', luster: 'Vítreo', habit: 'Prismático, acicular o fibroso', note: 'Polimorfo de la calcita: comparten fórmula pero cristalizan en sistemas distintos, ortorrómbico y trigonal. Con el tiempo el aragonito tiende a convertirse en calcita.', lab: 'Los cristales aciculares o las maclas seudohexagonales lo separan de la calcita. La prueba con ácido diluido requiere supervisión.', image: '/images/10-aragonito.jpeg' },
  { id: '11', name: 'Crisocola', category: 'Silicatos hidratados', color: 'Azul turquesa / verde azulado', hardness: '2–4', formula: 'Cu₂H₂Si₂O₅(OH)₄·nH₂O aprox.', streak: 'Blanca o azul muy pálida', luster: 'Vítreo, ceroso o mate', habit: 'Masivo, terroso o botrioidal', note: 'Su fórmula se escribe de forma aproximada porque el contenido de agua varía y casi nunca forma cristales definidos.', lab: 'Suele impregnar la roca en lugar de formar cristales propios, y es más blanda que la turquesa. Lavarse las manos después: contiene cobre.', image: '/images/11-crisocola.jpeg' },
  { id: '12', name: 'Atacamita', category: 'Haluros', color: 'Verde brillante / esmeralda', hardness: '3–3,5', formula: 'Cu₂Cl(OH)₃', streak: 'Verde pálida', luster: 'Vítreo', habit: 'Prismático, acicular o granular', note: 'Debe su nombre al desierto de Atacama, donde fue descrita por primera vez. Requiere cloro para formarse, de ahí que abunde en ambientes áridos y costeros.', lab: 'Presenta cristales prismáticos verde oscuro, mejor definidos que los de la crisocola. Separarla de la brochantita con certeza exige análisis químico.', image: '/images/12-atacamita.jpeg' },
  { id: '13', name: 'Azurita', category: 'Carbonatos', color: 'Azul intenso / profundo', hardness: '3,5–4', formula: 'Cu₃(CO₃)₂(OH)₂', streak: 'Azul claro', luster: 'Vítreo o mate', habit: 'Prismático, tabular o masivo', note: 'Carbonato de cobre inestable: expuesta al aire húmedo se altera poco a poco en malaquita verde, por lo que muchas muestras antiguas tienen los bordes verdosos.', lab: 'Deja raya azul clara. La crisocola, en cambio, la deja blanca o casi incolora.', image: '/images/13-azurita.jpeg' },
  { id: '14', name: 'Yeso fibroso', category: 'Sulfatos', color: 'Blanco, incoloro o crema', hardness: '2', formula: 'CaSO₄·2H₂O', streak: 'Blanca', luster: 'Sedoso o satinado', habit: 'Fibroso, con fibras paralelas', note: 'Variedad fibrosa del yeso, llamada también espato satinado. El brillo sedoso se debe a la orientación paralela de las fibras.', lab: 'Con dureza 2 se raya con la uña. Conviene hacer la prueba en un borde poco visible para no dañar la muestra.', image: '/images/14-yeso-fibroso.png' },
  { id: '15', name: 'Jaspe', category: 'Silicatos · calcedonia', color: 'Rojo, café, amarillo, verde o multicolor', hardness: '6,5–7', formula: 'SiO₂, con posibles impurezas', streak: 'Blanca', luster: 'Vítreo a mate', habit: 'Masivo, compacto y sin cristales visibles', note: 'Calcedonia opaca teñida por impurezas de hierro y arcilla, que pueden alcanzar cerca de un quinto del volumen de la roca. De ahí sus bandas y manchas.', lab: 'Raya el vidrio igual que el cuarzo. Lo distinguen la opacidad total y la fractura concoidea de aspecto mate.', image: '/images/15-jaspe.jpeg' },
  { id: '16', name: 'Hulla', category: 'Roca sedimentaria orgánica', color: 'Negro o negro parduzco', hardness: '1–3 aprox.', formula: 'Sin fórmula fija; contiene principalmente carbono', streak: 'Negra o pardo negruzca', luster: 'Mate a brillante', habit: 'Masivo, compacto o en capas', note: 'Carbón mineral formado por restos vegetales sepultados y comprimidos. Su contenido de carbono ronda el 75–90 %, por encima del lignito.', lab: 'Pesa poco para su volumen y mancha las manos al tomarla. No quemar la muestra.', image: '/images/16-hulla.jpeg' },
  { id: '17', name: 'Pirolusita', category: 'Óxidos', color: 'Negro / gris acero', hardness: '2–6,5 aprox.', formula: 'MnO₂', streak: 'Negra', luster: 'Metálico, submetálico o mate', habit: 'Acicular, fibroso, dendrítico o masivo', note: 'Principal mena de manganeso. Los agregados dendríticos que forma sobre planos de roca se confunden a menudo con fósiles de plantas.', lab: 'Deja raya negra sobre porcelana sin esmaltar. Mancha los dedos con facilidad, así que conviene lavarse las manos después.', image: '/images/17-pirolusita.jpeg' },
  { id: '18', name: 'Hematita', category: 'Óxidos', color: 'Rojo parduzco / gris acero', hardness: '5–6,5', formula: 'Fe₂O₃', streak: 'Roja a rojo parduzca', luster: 'Metálico, submetálico o terroso', habit: 'Masivo, terroso, granular o laminar', note: 'Principal mena de hierro. Su aspecto va del rojo terroso al gris metálico, pero la raya es siempre roja parda.', lab: 'La prueba de raya la separa de la magnetita, que la deja negra, y de la limonita, que la deja amarilla parda.', image: '/images/18-hematita.jpeg' },
  { id: '19', name: 'Calcopirita', category: 'Sulfuros', color: 'Amarillo latón / dorado', hardness: '3,5–4', formula: 'CuFeS₂', streak: 'Negra verdosa', luster: 'Metálico', habit: 'Masivo, granular o tetragonal', note: 'Principal mena de cobre. Expuesta al aire desarrolla un empañado iridiscente en tonos azules y morados.', lab: 'Se raya con un clavo de acero, cosa que no ocurre con la pirita. Su amarillo también es más intenso y algo verdoso.', image: '/images/19-calcopirita.jpeg' },
  { id: '20', name: 'Calcantita', category: 'Sulfatos hidratados', color: 'Azul intenso / celeste', hardness: '2,5', formula: 'CuSO₄·5H₂O', streak: 'Blanca o azul muy pálida', luster: 'Vítreo', habit: 'Prismático, granular o cristalino', note: 'Sulfato de cobre soluble en agua. Buena parte de los ejemplares de colección son cristales cultivados en laboratorio y no de origen natural.', lab: 'No mojar la muestra, porque se disuelve. Es tóxica por ingestión: lavarse las manos tras manipularla.', image: '/images/20-calcantita.jpeg' }
];
const categories = ['Todas', ...new Set(specimens.map((specimen) => specimen.category))];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Muestrario digital de 20 minerales y rocas con sus propiedades físicas y criterios de identificación." />
    <title>Taller 2: Logística y campaña de terreno</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');
      :root { --ink:#1e2926; --muted:#75807b; --paper:#f4f3ee; --line:#d8d9d2; --accent:#d96645; --sage:#a9bca8; --dark:#1d3732; }
      * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; overflow-x:hidden; }
      .grain { position:fixed; inset:0; pointer-events:none; z-index:20; opacity:.035; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E"); }
      a { color:inherit; text-decoration:none; } .site-header { height:83px; padding:0 6vw; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); position:relative; z-index:2; }
      .brand { display:flex; gap:11px; align-items:center; font-size:14px; line-height:1.3; letter-spacing:.08em; text-transform:uppercase; font-weight:600; } .brand i, footer i { font-family:'Playfair Display',serif; text-transform:none; letter-spacing:0; font-size:16px; }
      .brand-mark { width:32px; height:32px; border:1px solid var(--ink); border-radius:50%; display:grid; place-items:center; font:500 10px 'DM Mono'; letter-spacing:-.08em; }
      nav { display:flex; gap:38px; margin-left:8%; font-size:13px; color:#5f6965; } nav a { transition:color .2s; } nav a:hover { color:var(--accent); } nav span { color:var(--accent); font:11px 'DM Mono'; vertical-align:super; margin-left:3px; }
      .header-cta { font-size:12px; background:var(--dark); color:#fff; padding:13px 18px; border-radius:2px; } .header-cta span { margin-left:12px; color:#e7ad91; font-size:16px; }
      .hero { min-height:calc(100vh - 83px); padding:10vh 10vw 35px; position:relative; display:grid; grid-template-columns:1fr 1fr; align-items:center; max-width:1600px; margin:auto; }
      .eyebrow { font:11px 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.12em; color:var(--accent); margin:0 0 26px; } h1,h2,h3,p { margin-top:0; } h1 { font-size:clamp(60px,8vw,118px); line-height:.92; letter-spacing:-.07em; font-weight:500; margin:0 0 36px; } h1 em,h2 em { font-family:'Playfair Display',serif; font-weight:500; letter-spacing:-.06em; } .intro { max-width:330px; color:#68736e; font-size:15px; line-height:1.6; margin-bottom:34px; }
      .primary-button { background:var(--accent); color:#fff; display:inline-flex; gap:38px; align-items:center; padding:16px 19px; font-size:12px; font-weight:600; } .primary-button span { font-size:19px; font-weight:400; }
      .hero-art { position:relative; aspect-ratio:4/3; margin-left:4vw; background:#000; overflow:hidden; } .hero-art img { width:100%; height:100%; display:block; object-fit:cover; }
      .art-label { position:absolute; bottom:34px; left:31px; font:11px 'DM Mono'; line-height:1.65; color:#dfe4da; text-transform:uppercase; } .art-label span { color:var(--accent); margin-right:12px; } .art-label strong { font-weight:400; color:#fff; } .vertical-label { position:absolute; top:28px; right:22px; writing-mode:vertical-rl; text-transform:uppercase; font:10px 'DM Mono'; letter-spacing:.1em; color:#9aa89f; }
      .hero-foot { position:absolute; bottom:35px; left:10vw; right:10vw; border-top:1px solid var(--line); padding-top:14px; display:flex; justify-content:space-between; color:#7c8580; text-transform:uppercase; font:10px 'DM Mono'; letter-spacing:.1em; }
      .statement { background:var(--dark); color:#eef0e7; padding:150px 14vw; display:grid; grid-template-columns:1fr 1fr; min-height:550px; align-items:center; } .statement .eyebrow { color:#e7ad91; } h2 { font-size:clamp(42px,5vw,76px); line-height:.98; font-weight:500; letter-spacing:-.06em; margin:0; } .statement-detail { align-self:end; padding:0 6vw 10px 0; display:flex; gap:22px; color:#aebdb4; font-size:14px; line-height:1.65; max-width:440px; } .detail-line { display:block; width:40px; height:1px; margin-top:9px; flex:none; background:#d96645; }
      .catalog { padding:130px 8vw 150px; max-width:1500px; margin:auto; } .section-heading { display:flex; justify-content:space-between; align-items:end; margin-bottom:62px; } .section-heading .eyebrow { margin-bottom:20px; } .section-count { text-align:right; color:var(--muted); font:10px 'DM Mono'; text-transform:uppercase; line-height:1.8; } .section-count strong { color:var(--accent); font:42px 'Playfair Display'; }
      .catalog-tools { border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:17px 0; display:flex; justify-content:space-between; align-items:center; gap:20px; } .search-wrap { display:flex; gap:10px; align-items:center; color:var(--accent); } .search-wrap span { font-size:28px; transform:rotate(-20deg); } input { border:0; background:none; outline:0; font:13px 'DM Sans'; color:var(--ink); width:180px; } input::placeholder { color:#969d98; } .filters { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:6px; } .filters button { border:1px solid transparent; background:none; padding:7px 10px; color:#78817c; font:10px 'DM Mono'; cursor:pointer; } .filters button.active,.filters button:hover { color:var(--accent); border-color:#e4b7a5; }
      .results-meta { min-height:48px; display:flex; justify-content:space-between; align-items:center; color:#929993; font:10px 'DM Mono'; text-transform:uppercase; } #clear-filters { border:0; background:none; color:var(--accent); font:10px 'DM Mono'; cursor:pointer; }
      .specimen-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:42px 18px; } .specimen-card[hidden] { display:none; } .card-button { display:block; border:0; background:none; padding:0; text-align:left; width:100%; cursor:pointer; color:var(--ink); } .card-image { aspect-ratio:1.1; background:#000; overflow:hidden; position:relative; } .card-image img { width:100%; height:100%; display:block; object-fit:cover; filter:saturate(.7); transition:transform .5s,filter .5s; } .card-button:hover img { transform:scale(1.05); filter:saturate(1); } .card-number { position:absolute; top:13px; left:14px; color:#fff; font:10px 'DM Mono'; } .view-icon { position:absolute; bottom:13px; right:14px; color:#fff; font-size:21px; opacity:0; transition:opacity .2s; } .card-button:hover .view-icon { opacity:1; } .card-info { position:relative; padding:14px 0; border-bottom:1px solid var(--line); } .card-info h3 { font:500 19px 'Playfair Display'; margin-bottom:5px; } .card-info p { color:#8a928e; font:10px 'DM Mono'; text-transform:uppercase; margin:0; } .swatch { position:absolute; right:0; top:19px; width:9px; height:9px; border-radius:50%; border:1px solid #9da69e; background:var(--swatch); }
      .empty-state { color:var(--muted); padding:70px 0; font-family:'Playfair Display'; font-size:24px; text-align:center; }
      .lab-note { border-top:1px solid var(--line); margin-top:28px; padding-top:18px; color:#69746e; font-size:12px; line-height:1.55; } .lab-note strong { color:var(--accent); display:block; font:10px 'DM Mono'; letter-spacing:.08em; text-transform:uppercase; margin-bottom:6px; } .lab-note span { display:block; }
      .references { background:#e4e5dc; padding:120px 14vw; display:grid; grid-template-columns:1fr 1fr; gap:12vw; } .reference-list { padding-top:10px; } .reference-list a { padding:21px 0; border-bottom:1px solid #bdc5bb; display:grid; grid-template-columns:40px 1fr 20px; gap:10px; font-size:13px; color:#52615a; } .reference-list span { color:var(--accent); font:10px 'DM Mono'; } .reference-list b { font-weight:400; color:var(--accent); }
      .credits { padding:120px 14vw; display:grid; grid-template-columns:1fr 1fr; gap:12vw; } .member-list { padding:10px 0 0; margin:0; list-style:none; counter-reset:member; } .member-list li { counter-increment:member; padding:21px 0; border-bottom:1px solid var(--line); display:grid; grid-template-columns:40px 1fr; gap:10px; font-size:14px; color:#52615a; } .member-list li:before { content:counter(member,decimal-leading-zero); color:var(--accent); font:10px 'DM Mono'; }
      footer { padding:25px 8vw; background:var(--dark); color:#b6c1ba; display:flex; justify-content:space-between; font:10px 'DM Mono'; text-transform:uppercase; letter-spacing:.08em; } footer i { color:#fff; }
      dialog { padding:0; border:0; max-width:1000px; max-height:90vh; width:calc(100% - 40px); overflow:auto; background:var(--paper); color:var(--ink); box-shadow:0 20px 70px #172a2580; } dialog::backdrop { background:#13231f99; backdrop-filter:blur(4px); } .modal-close { position:absolute; z-index:2; right:18px; top:12px; border:0; background:none; font-size:29px; font-weight:200; color:#fff; cursor:pointer; } .modal-image { width:44%; position:absolute; inset:0 auto 0 0; background:#000; } .modal-image img { width:100%; height:100%; display:block; object-fit:contain; } .modal-content { margin-left:44%; padding:56px 52px; min-height:510px; } .modal-content .eyebrow { margin-bottom:18px; } .modal-content h2 { font-size:52px; margin-bottom:23px; } .modal-note { color:#69746e; font-size:14px; line-height:1.65; max-width:370px; } dl { border-top:1px solid var(--line); margin-top:40px; display:grid; grid-template-columns:1fr 1fr; gap:18px 30px; padding-top:20px; } dt { color:var(--accent); font:10px 'DM Mono'; text-transform:uppercase; margin-bottom:5px; } dd { margin:0; font-size:13px; color:#59655f; }
      @media (max-width:800px) { .site-header { padding:0 5vw; } .brand { font-size:11px; } .brand i { font-size:13px; } nav { display:none; } .header-cta { padding:10px; font-size:10px; } .hero { display:block; padding:80px 7vw 100px; } .hero-art { margin:60px 0 0; } .hero-foot { left:7vw; right:7vw; bottom:28px; } .hero-foot span:last-child { display:none; } .statement,.references,.credits { display:block; padding:90px 8vw; } .statement-detail { margin-top:70px; } .catalog { padding:90px 6vw; } .section-heading { align-items:start; } .section-heading h2 { font-size:48px; } .section-count { margin-top:32px; } .catalog-tools { display:block; } .filters { justify-content:flex-start; margin-top:18px; } .specimen-grid { grid-template-columns:repeat(2,1fr); gap:30px 12px; } .card-info h3 { font-size:16px; } .references h2,.credits h2 { margin-bottom:60px; } footer { display:block; line-height:2; } footer span { display:block; } .modal-image { position:relative; width:100%; height:280px; } .modal-content { margin:0; min-height:0; padding:35px 28px 42px; } .modal-content h2 { font-size:42px; } .modal-close { color:var(--ink); } }
    </style>
  </head>
  <body>
    <div class="grain"></div>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Taller 2: Logística y campaña de terreno, inicio">
        <span class="brand-mark">T2</span>
        <span>Taller 2<br /><i>Logística y campaña de terreno</i></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#muestras">Muestras <span>20</span></a>
        <a href="#metodo">Clasificación</a>
        <a href="#referencias">Referencias</a>
      </nav>
      <a class="header-cta" href="#muestras">Ver las muestras <span>↘</span></a>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="hero-copy">
          <p class="eyebrow">Muestras 01 a 20</p>
          <h1>Muestrario<br /><em>de minerales.</em></h1>
          <p class="intro">Veinte muestras de minerales y rocas descritas a partir de sus propiedades físicas: color, dureza, raya, brillo y hábito.</p>
          <a class="primary-button" href="#muestras">Ver el catálogo <span>→</span></a>
        </div>
        <div class="hero-art">
          <img src="/images/00-portada.png" alt="Conjunto de minerales de distintos colores dispuestos sobre fondo negro." />
          <div class="art-label"><span>20</span> muestras<br /><strong>clasificadas por composición</strong></div>
          <div class="vertical-label">propiedades físicas</div>
        </div>
        <div class="hero-foot"><span>Identificación de minerales</span><span>Catálogo más abajo ↓</span></div>
      </section>

      <section class="statement" id="metodo">
        <p class="eyebrow">Criterio de clasificación</p>
        <h2>Agrupadas por<br /><em>composición química.</em></h2>
        <div class="statement-detail"><span class="detail-line"></span><p>Las muestras se ordenan por composición química: óxidos, sulfuros, sulfatos, carbonatos, haluros, silicatos y elementos nativos. Se incluyen además algunas rocas y un material artificial, que no corresponden a una sola especie mineral. Cada ficha registra color, dureza Mohs, raya, brillo y hábito.</p></div>
      </section>

      <section class="catalog" id="muestras">
        <div class="section-heading">
          <div><p class="eyebrow">Catálogo</p><h2>Las muestras,<br /><em>una por una.</em></h2></div>
          <p class="section-count"><strong>20</strong><br />fichas de identificación</p>
        </div>
        <div class="catalog-tools">
          <div class="search-wrap"><span>⌕</span><input id="search" type="search" placeholder="Buscar por nombre..." aria-label="Buscar por nombre" /></div>
          <div class="filters" role="group" aria-label="Filtrar por categoría">
            {categories.map((category, index) => <button class:list:active={index === 0} data-category={category}>{category}</button>)}
          </div>
        </div>
        <div class="results-meta"><span id="results-count">20 muestras</span><button id="clear-filters" hidden>Limpiar filtros ×</button></div>
        <div class="specimen-grid" id="specimen-grid">
          {specimens.map((specimen) => (
            <article class="specimen-card" data-name={specimen.name.toLowerCase()} data-category={specimen.category}>
              <button class="card-button" data-id={specimen.id} data-name={specimen.name} data-image={specimen.image} data-note={specimen.note} data-category={specimen.category} data-color={specimen.color} data-hardness={specimen.hardness} data-formula={specimen.formula} data-streak={specimen.streak} data-luster={specimen.luster} data-habit={specimen.habit} data-lab={specimen.lab} aria-label={`Ver detalles de ${specimen.name}`}>
                <div class="card-image"><img src={specimen.image} alt="" loading="lazy" /><span class="card-number">{specimen.id}</span><span class="view-icon">↗</span></div>
                <div class="card-info"><h3>{specimen.name}</h3><p>{specimen.category}</p><span class="swatch" style={`--swatch: ${specimen.color}`}></span></div>
              </button>
            </article>
          ))}
        </div>
        <p class="empty-state" id="empty-state" hidden>Ninguna muestra coincide con la búsqueda.</p>
      </section>

      <section class="references" id="referencias">
        <div><p class="eyebrow">Referencias</p><h2>Fuentes<br /><em>consultadas.</em></h2></div>
        <div class="reference-list"><a href="https://msaweb.org/mineral-id-key/" target="_blank" rel="noreferrer"><span>01</span> Mineralogical Society of America · Mineral ID Key <b>↗</b></a><a href="https://earth.appstate.edu/outreach/ask-geologist/mineral-identification-tables" target="_blank" rel="noreferrer"><span>02</span> Appalachian State · tablas de identificación <b>↗</b></a><a href="https://australian.museum/learn/minerals/properties/" target="_blank" rel="noreferrer"><span>03</span> Australian Museum · propiedades minerales <b>↗</b></a><a href="https://geology.utah.gov/map-pub/survey-notes/glad-you-asked/how-do-geologists-identify-minerals/" target="_blank" rel="noreferrer"><span>04</span> Utah Geological Survey · identificación <b>↗</b></a></div>
      </section>
      <section class="credits" id="integrantes">
        <div><p class="eyebrow">Equipo</p><h2>Integrantes<br /><em>del grupo.</em></h2></div>
        <ol class="member-list">
          <li>Nidia Pizarro</li>
          <li>Constanza Talavera</li>
          <li>Ezequiel Fernández</li>
        </ol>
      </section>
    </main>
    <footer><span>Taller 2 <i>Logística y campaña de terreno</i> · 2026</span><span>Muestrario de minerales y rocas · 20 fichas</span></footer>

    <dialog id="detail-modal" aria-labelledby="modal-title">
      <button class="modal-close" id="modal-close" aria-label="Cerrar detalle">×</button>
      <div class="modal-image"><img id="modal-image" alt="" /></div>
      <div class="modal-content"><p class="eyebrow" id="modal-id"></p><h2 id="modal-title"></h2><p class="modal-note" id="modal-note"></p><dl><div><dt>Grupo</dt><dd id="modal-category"></dd></div><div><dt>Color observado</dt><dd id="modal-color"></dd></div><div><dt>Fórmula química</dt><dd id="modal-formula"></dd></div><div><dt>Dureza Mohs</dt><dd id="modal-hardness"></dd></div><div><dt>Raya</dt><dd id="modal-streak"></dd></div><div><dt>Brillo</dt><dd id="modal-luster"></dd></div><div><dt>Hábito o forma</dt><dd id="modal-habit"></dd></div></dl><div class="lab-note"><strong>Identificación en laboratorio</strong><span id="modal-lab"></span></div></div>
    </dialog>
    <script>
      const cards = [...document.querySelectorAll('.specimen-card')];
      const search = document.querySelector('#search');
      const count = document.querySelector('#results-count');
      const empty = document.querySelector('#empty-state');
      const clear = document.querySelector('#clear-filters');
      let activeCategory = 'Todas';
      function render() {
        const query = search.value.toLowerCase().trim();
        let visible = 0;
        cards.forEach((card) => {
          const matches = (!query || card.dataset.name.includes(query)) && (activeCategory === 'Todas' || card.dataset.category === activeCategory);
          card.hidden = !matches;
          if (matches) visible++;
        });
        count.textContent = `${visible} ${visible === 1 ? 'muestra' : 'muestras'}`;
        empty.hidden = visible !== 0;
        clear.hidden = !query && activeCategory === 'Todas';
      }
      document.querySelectorAll('.filters button').forEach((button) => button.addEventListener('click', () => {
        activeCategory = button.dataset.category;
        document.querySelectorAll('.filters button').forEach((item) => item.classList.toggle('active', item === button));
        render();
      }));
      search.addEventListener('input', render);
      clear.addEventListener('click', () => { search.value = ''; activeCategory = 'Todas'; document.querySelectorAll('.filters button').forEach((item, index) => item.classList.toggle('active', index === 0)); render(); });
      const dialog = document.querySelector('#detail-modal');
      document.querySelectorAll('.card-button').forEach((button) => button.addEventListener('click', () => {
        const specimen = button.dataset;
        document.querySelector('#modal-image').src = specimen.image;
        document.querySelector('#modal-image').alt = specimen.name;
        document.querySelector('#modal-id').textContent = `Muestra · ${specimen.id}`;
        document.querySelector('#modal-title').textContent = specimen.name;
        document.querySelector('#modal-note').textContent = specimen.note;
        document.querySelector('#modal-category').textContent = specimen.category;
        document.querySelector('#modal-color').textContent = specimen.color;
        document.querySelector('#modal-formula').textContent = specimen.formula;
        document.querySelector('#modal-hardness').textContent = specimen.hardness;
        document.querySelector('#modal-streak').textContent = specimen.streak;
        document.querySelector('#modal-luster').textContent = specimen.luster;
        document.querySelector('#modal-habit').textContent = specimen.habit;
        document.querySelector('#modal-lab').textContent = specimen.lab;
        dialog.showModal();
      }));
      document.querySelector('#modal-close').addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    </script>
  </body>
</html>
